body {
  margin: 0;
  font-family: 'Segoe UI', sans-serif;
  background: #f4f7fc;
  color: #333;
}

#app {
  max-width: 900px;
  margin: 0 auto;
  padding: 20px;
}

header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

h1 {
  font-weight: 700;
  margin: 0;
}

.status span {
  background: #fff;
  border-radius: 8px;
  padding: 6px 12px;
  margin-left: 8px;
  font-size: 14px;
  border: 1px solid #dcdfea;
}

#menu h2 {
  margin-top: 24px;
  margin-bottom: 12px;
}

.quest-list {
  display: flex;
  gap: 16px;
  flex-wrap: wrap;
}

.quest-btn {
  border: none;
  padding: 10px;
  border-radius: 12px;
  cursor: pointer;
  background: #ffffff;
  border: 2px solid #dbe2f4;
  width: 260px;
  text-align: center;
  font-weight: 600;
  transition: 0.2s;
}

.quest-btn:hover {
  transform: scale(1.03);
  border-color: #8aa8ff;
}

.thumb {
  width: 100%;
  border-radius: 10px;
  margin-bottom: 8px;
}

.hidden {
  display: none;
}

#game {
  margin-top: 24px;
}

#quest-image img {
  width: 100%;
  border-radius: 10px;
}

#quest-text {
  font-size: 20px;
  margin: 16px 0;
  min-height: 60px;
}

#answers button {
  display: block;
  width: 100%;
  background: #fff;
  font-size: 18px;
  border: 2px solid #dbe2f4;
  padding: 10px;
  border-radius: 10px;
  margin-bottom: 8px;
  cursor: pointer;
}

#answers button:hover {
  border-color: #8aa8ff;
}

#next-btn {
  margin-top: 20px;
  padding: 10px 18px;
  border: none;
  background: #8aa8ff;
  color: #fff;
  border-radius: 10px;
  font-size: 18px;
  cursor: pointer;
}
